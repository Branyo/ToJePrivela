<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>391adb21-5777-402c-8591-bc3b5882b1f5</UserSecretsId>
  </PropertyGroup>

  <!-- GET /api/info reports the informational version. Without an explicit version (dotnet publish -p:Version=1.4.0)
       the SDK would stamp "1.0.0" on every build, so unversioned builds carry none and report "unknown" instead. -->
  <PropertyGroup Condition="'$(Version)' == '' and '$(VersionPrefix)' == ''">
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToJePrivela.Application\ToJePrivela.Application.csproj" />
    <ProjectReference Include="..\ToJePrivela.Infrastructure\ToJePrivela.Infrastructure.csproj" />
    <ProjectReference Include="..\ToJePrivela.Ai\ToJePrivela.Ai.csproj" />
    <ProjectReference Include="..\ToJePrivela.Identity\ToJePrivela.Identity.csproj" />
  </ItemGroup>

</Project>
