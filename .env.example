# Copy to .env and fill in. .env holds secrets: it is gitignored and must never be committed.

# Signs the login tokens: a random text of at least 32 characters. Changing it signs everybody out.
JWT_SIGNING_KEY=

# The admin login that manages categories and questions (password 6-128 characters).
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Optional: without it the game works, but AI question generation and category name translation are unavailable.
OPENAI_API_KEY=

# ":80" serves plain HTTP. Set a domain (e.g. tojeprivela.sk) once it points at the server, and Caddy turns on HTTPS.
SITE_ADDRESS=:80

# The port on this machine; change it when 80 is taken (e.g. 8080, then open http://localhost:8080).
HTTP_PORT=80
